# Copia este archivo a .env en la raíz del repositorio.
# El backend y el frontend leen las variables desde ahí.
# Oracle Database (19c o superior) guarda los datos. Crea el usuario con
# backend/sql/admin/crear_usuario.sql y ejecuta npm run db:migrate --prefix backend.

# Backend (Express)
PORT=3000

# Oracle Database
# DB_CONNECT_STRING es host:puerto/servicio. El servicio es el de la base conectable (PDB):
# FREEPDB1 en Oracle Free, XEPDB1 en Oracle XE, o el que indique el administrador.
DB_USER=rideu
DB_PASSWORD=
DB_CONNECT_STRING=localhost:1521/FREEPDB1
# Opcionales: tamaño del pool de conexiones (por defecto 1 y 10).
DB_POOL_MIN=1
DB_POOL_MAX=10

# Frontend (Vite solo expone variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000

# Enlace que recibe la persona en el correo. Apunta al frontend.
APP_URL=http://localhost:5173

# Correo de verificación.
# console imprime el enlace en la terminal del backend. No envía nada.
# smtp lo envía con las credenciales de abajo. No las pongas en el código.
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io y SMTP_PORT=2525
# Ethereal: SMTP_HOST=smtp.ethereal.email y SMTP_PORT=587
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ride U <no-reply@rideu.local>

# Copia este archivo a .env en la raíz del repositorio.
# El backend y el frontend leen las variables desde ahí.
# PostgreSQL guarda las cuentas de usuario. Crea la base y ejecuta npm run db:migrate --prefix backend.

# Backend (Express)
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/rideu

# Frontend (Vite solo expone variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000

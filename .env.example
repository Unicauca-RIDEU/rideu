# Copia este archivo a .env en la raíz del repositorio.
# El backend y el frontend leen las variables desde ahí.
# PostgreSQL guarda las cuentas de usuario. Crea la base y ejecuta npm run db:migrate --prefix backend.

# Backend (Express)
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://usuario:password@localhost:5432/rideu

# Frontend (Vite solo expone variables con prefijo VITE_)
VITE_API_URL=http://localhost:3000

# Enlace que recibe la persona en el correo. Apunta al frontend.
APP_URL=http://localhost:5173

# Correo de verificación.
# console imprime el enlace en la terminal del backend. No envía nada.
# smtp lo envía con las credenciales de abajo. No las pongas en el código.
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io y SMTP_PORT=2525
# Ethereal: SMTP_HOST=smtp.ethereal.email y SMTP_PORT=587
MAIL_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Ride U <no-reply@rideu.local>
